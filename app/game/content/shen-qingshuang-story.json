{
  "character": {
    "bio": "问剑峰主，剑心澄澈却不善安放自己的牵挂。她习惯把担忧写成训诫，把等待藏进一盏反复温热的茶。",
    "ambientLines": [
      "剑招可以重来，伤势不能。把手伸来，我看看。",
      "今日山风很静。你若无事，便陪为师把这盏茶喝完。",
      "你下山历练并无不妥……只是回来时，记得先到问剑峰报一声平安。",
      "为师并未等你。只是这壶茶恰好温了第三回。",
      "修行要学会取舍，却不必把所有牵挂都舍掉。",
      "你身上沾了陌生的梅香。罢了，不想说便不说，我没有在意。",
      "小时候你怕雷，总攥着我的袖口。如今胆子大了，倒让我有些不习惯。",
      "若外面的路太冷，问剑峰永远替你留一盏灯。"
    ]
  },
  "dialogueProfile": {
    "id": "dialogue.shen-qingshuang.v2",
    "characterId": "shen",
    "rules": [
      {
        "id": "shen-morning",
        "minRelationship": 0,
        "maxRelationship": 100,
        "period": "清晨",
        "lines": [
          "晨课迟了半刻。是昨夜练剑，还是又把被子踢开了？",
          "先饮温水，再握剑。剑修也不是铁石做的。",
          "朝云尚未散，陪我走到崖边。今日不考你的剑式。",
          "你眼下有倦色。说实话，为师不会因此责罚你。",
          "早膳在案上。不是特意为你做的，只是分量算错了。"
        ],
        "closingAfter": 3,
        "closingLine": "晨钟已经响过三遍。去吧，晚些再来，我仍在这里。"
      },
      {
        "id": "shen-forenoon",
        "minRelationship": 0,
        "maxRelationship": 100,
        "period": "上午",
        "lines": [
          "这一式太急。你总想着赶到别人前面，却忘了身后也有人看着你。",
          "剑尖再稳一寸。很好……别回头，我方才没有笑。",
          "今日若要下山，把行程写在玉简上。不是约束，是让我知道去哪里接你。",
          "你悟性很好，所以更要学会敬畏自己的极限。",
          "有人托我问你的近况。我说你尚可——其实，比尚可更好。"
        ],
        "closingAfter": 3,
        "closingLine": "今日指点到此。再练下去，你会逞强给我看。"
      },
      {
        "id": "shen-afternoon",
        "minRelationship": 0,
        "maxRelationship": 100,
        "period": "午后",
        "lines": [
          "方才与你说话的姑娘是谁？随口一问，不必答得那样快。",
          "殿外日光正好。你坐近些，卷宗上的小字看久了伤眼。",
          "你笑时总爱偏过头。小时候也是，以为这样便没人看见。",
          "为师今日没有要事。若你愿意，可以把山下见闻讲给我听。",
          "这枚护身符拿着。它只护命，不会替我窥听你的行踪。"
        ],
        "closingAfter": 3,
        "closingLine": "午后的话已经太多。再说下去，我怕自己失了分寸。"
      },
      {
        "id": "shen-dusk",
        "minRelationship": 0,
        "maxRelationship": 100,
        "period": "黄昏",
        "lines": [
          "黄昏之后山道难行。你若要走，我送你到云阶。",
          "今日回来得比昨日早。很好……我是说，你的时间安排得很好。",
          "看见那只归巢的鹤了吗？它每次远行，都知道有人在等。",
          "暮色像极了我们初见那日。只是那时，我没想过会等一个人这么多年。",
          "你可以有自己的路。只需偶尔回头，让我知道你没有走丢。"
        ],
        "closingAfter": 3,
        "closingLine": "天色沉了。今日最后一句——路上小心。"
      },
      {
        "id": "shen-night",
        "minRelationship": 0,
        "maxRelationship": 100,
        "period": "夜晚",
        "lines": [
          "这么晚还来，是睡不着，还是终于想起为师了？",
          "月下不谈戒律。坐吧，今夜你我都只是未眠之人。",
          "你小时候做噩梦，会抓住我的衣襟。如今若还怕，也不算丢脸。",
          "别躲那么远。剑气伤不到你，我也不会。",
          "我曾以为清静最好。后来才知道，清静与寂寞不是一回事。"
        ],
        "closingAfter": 3,
        "closingLine": "夜深了。回去睡吧——走慢些，让我再看一会儿。"
      },
      {
        "id": "shen-late-night",
        "minRelationship": 0,
        "maxRelationship": 100,
        "period": "深夜",
        "lines": [
          "你听见我唤你了？大约是风声。为师没有在梦里叫你的名字。",
          "若时间停在今夜，也未必是坏事。至少你还坐在这里。",
          "我有时会想，把山门关上是不是就能少担心一些……放心，我不会那样做。",
          "今夜的酒不是我的。你若闻见酒气，多半是苏晚棠来过。",
          "有一句话我练习过很多次，见到你却总说不出口。再等等吧。"
        ],
        "closingAfter": 3,
        "closingLine": "再不休息，明日你我都要误了晨课。去吧，我答应不再留你。"
      }
    ]
  },
  "events": [
    {
      "id": "shen.frostbond.01.return-in-snow",
      "title": "雪阶归人",
      "subtitle": "一盏茶被温了又温",
      "chapter": "霜华心契 · 壹",
      "type": "相识",
      "trigger": "scene_enter",
      "priority": 150,
      "once": true,
      "journal": true,
      "cardStyle": "special",
      "openingEffect": "flash_white",
      "defaultPortrait": "/assets/characters/shen-qingshuang.webp",
      "sceneId": "lingxiao",
      "characterId": "shen",
      "conditions": [{ "type": "scene", "value": "lingxiao" }],
      "clue": "新篇章开始后回到凌霄殿",
      "start": "a",
      "nodes": {
        "a": { "id": "a", "type": "line", "speaker": "narrator", "text": "风雪压低了凌霄殿的檐角。沈清霜独自坐在长阶尽头，案上的茶盏已经换过三次热水。", "next": "b", "portrait": "/assets/characters/shen-qingshuang.webp", "stageEffect": "soft_glow" },
        "b": { "id": "b", "type": "line", "speaker": "shen", "text": "回来了？比传讯里说的迟了两个时辰。", "mood": "克制的担忧", "next": "c", "portrait": "/assets/characters/shen-qingshuang.webp" },
        "c": { "id": "c", "type": "line", "speaker": "player", "text": "路上遇到受伤的商队，耽搁了一阵。师尊一直在等我？", "next": "d", "portrait": "/assets/characters/shen-qingshuang.webp" },
        "d": { "id": "d", "type": "line", "speaker": "shen", "text": "并未。只是殿里太静，我不想这么早熄灯。", "mood": "嘴硬", "next": "e", "portrait": "/assets/characters/shen-qingshuang.webp", "stageEffect": "heartbeat" },
        "e": { "id": "e", "type": "choice", "prompt": "雪落在她肩头，你准备如何回应？", "portrait": "/assets/characters/shen-qingshuang.webp", "stageEffect": "heartbeat", "options": [
          { "id": "stay", "label": "坐下陪她喝完这盏茶", "next": "f", "effects": [{ "type": "relationship", "characterId": "shen", "amount": 5 }] },
          { "id": "promise", "label": "答应以后先报一声平安", "next": "g", "effects": [{ "type": "relationship", "characterId": "shen", "amount": 4 }] }
        ] },
        "f": { "id": "f", "type": "line", "speaker": "shen", "text": "茶已经淡了。你若不嫌，便坐近些，别让风把热气吹散。", "mood": "稍缓", "next": "end", "portrait": "/assets/characters/shen-qingshuang.webp", "stageEffect": "soft_glow" },
        "g": { "id": "g", "type": "line", "speaker": "shen", "text": "不必事事禀报。只需让我知道，你仍会回来。", "mood": "认真", "next": "end", "portrait": "/assets/characters/shen-qingshuang.webp", "stageEffect": "soft_glow" },
        "end": { "id": "end", "type": "end", "summary": "长阶上的灯一直亮到雪停。", "effects": [{ "type": "set_flag", "key": "shen.frostbond.started", "value": true }] }
      }
    },
    {
      "id": "shen.frostbond.02.heart-manual",
      "title": "案底心书",
      "subtitle": "剑谱下面藏着一本不该出现的书",
      "chapter": "霜华心契 · 贰",
      "type": "心事",
      "trigger": "inspection",
      "priority": 148,
      "once": true,
      "journal": true,
      "cardStyle": "special",
      "openingEffect": "flash_white",
      "defaultPortrait": "/assets/characters/shen-qingshuang.webp",
      "inspection": { "chance": 100, "hint": true },
      "sceneId": "lingxiao",
      "characterId": "shen",
      "conditions": [
        { "type": "period", "value": "夜晚" },
        { "type": "event_completed", "eventId": "shen.frostbond.01.return-in-snow" }
      ],
      "clue": "夜晚检视凌霄殿的书案",
      "start": "a",
      "nodes": {
        "a": { "id": "a", "type": "line", "speaker": "narrator", "text": "你在剑谱下抽出一本薄册，封面写着《如何让远行之人记得归家》。", "next": "b", "portrait": "/assets/characters/shen-qingshuang.webp" },
        "b": { "id": "b", "type": "line", "speaker": "shen", "text": "放下。那不是我的书。", "mood": "骤然慌乱", "next": "c", "portrait": "/assets/characters/shen-qingshuang.webp", "stageEffect": "shake" },
        "c": { "id": "c", "type": "line", "speaker": "player", "text": "书页上有师尊的批注：第一条，不可逼得太紧。", "next": "d", "portrait": "/assets/characters/shen-qingshuang.webp" },
        "d": { "id": "d", "type": "line", "speaker": "shen", "text": "我是在研究人心破绽，与旁的事情无关。", "mood": "强作镇定", "next": "e", "portrait": "/assets/characters/shen-qingshuang.webp" },
        "e": { "id": "e", "type": "choice", "prompt": "她伸手来夺那本薄册。", "portrait": "/assets/characters/shen-qingshuang.webp", "options": [
          { "id": "return", "label": "合上书，替她保守秘密", "next": "f", "effects": [{ "type": "relationship", "characterId": "shen", "amount": 4 }] },
          { "id": "tease", "label": "问第二条批注是什么", "next": "g", "effects": [{ "type": "relationship", "characterId": "shen", "amount": 3 }] }
        ] },
        "f": { "id": "f", "type": "line", "speaker": "shen", "text": "你什么都没看见。作为交换，明日我少罚你练一遍剑。", "mood": "耳尖微红", "next": "end", "portrait": "/assets/characters/shen-qingshuang.webp", "stageEffect": "soft_glow" },
        "g": { "id": "g", "type": "line", "speaker": "shen", "text": "第二条是——对得寸进尺的弟子，立刻没收薄册。", "mood": "羞恼", "next": "end", "portrait": "/assets/characters/shen-qingshuang.webp" },
        "end": { "id": "end", "type": "end", "summary": "那本心书被她收走，书签却悄悄落在你袖中。" }
      }
    },
    {
      "id": "shen.frostbond.03.plum-scent",
      "title": "梅香来处",
      "subtitle": "她闻见了不属于问剑峰的香气",
      "chapter": "霜华心契 · 叁",
      "type": "情缘",
      "trigger": "talk",
      "priority": 146,
      "once": true,
      "journal": true,
      "cardStyle": "special",
      "defaultPortrait": "/assets/characters/shen-qingshuang.webp",
      "sceneId": "lingxiao",
      "characterId": "shen",
      "conditions": [
        { "type": "character", "value": "shen" },
        { "type": "event_completed", "eventId": "shen.frostbond.02.heart-manual" }
      ],
      "clue": "完成「案底心书」后与沈清霜交谈",
      "start": "a",
      "nodes": {
        "a": { "id": "a", "type": "line", "speaker": "shen", "text": "站住。你袖上为何有山下的梅香？", "mood": "平静得过分", "next": "b", "portrait": "/assets/characters/shen-qingshuang.webp" },
        "b": { "id": "b", "type": "line", "speaker": "player", "text": "替一位摔伤的姑娘扶了药筐，香气大约是那时沾上的。", "next": "c", "portrait": "/assets/characters/shen-qingshuang.webp" },
        "c": { "id": "c", "type": "line", "speaker": "shen", "text": "你倒热心。她可曾问过你的名字、住处，还有何时再下山？", "mood": "吃味", "next": "d", "portrait": "/assets/characters/shen-qingshuang.webp", "stageEffect": "heartbeat" },
        "d": { "id": "d", "type": "choice", "prompt": "她看似在问案情，手指却攥紧了剑穗。", "portrait": "/assets/characters/shen-qingshuang.webp", "options": [
          { "id": "reassure", "label": "告诉她，归山时最先想见的是师尊", "next": "e", "effects": [{ "type": "relationship", "characterId": "shen", "amount": 6 }, { "type": "set_flag", "key": "shen.frostbond.reassured", "value": true }] },
          { "id": "boundary", "label": "认真说，关心不该变成查问", "next": "f", "effects": [{ "type": "relationship", "characterId": "shen", "amount": 4 }, { "type": "set_flag", "key": "shen.frostbond.boundary", "value": true }] }
        ] },
        "e": { "id": "e", "type": "line", "speaker": "shen", "text": "这种话不要随便说。至少……不要对别人说。", "mood": "动摇", "next": "end", "portrait": "/assets/characters/shen-qingshuang.webp", "stageEffect": "soft_glow" },
        "f": { "id": "f", "type": "line", "speaker": "shen", "text": "你说得对。是我越界了。往后我会先问你愿不愿意说。", "mood": "克制反省", "next": "end", "portrait": "/assets/characters/shen-qingshuang.webp", "stageEffect": "soft_glow" },
        "end": { "id": "end", "type": "end", "summary": "梅香被山风吹散，你们之间却多了一句真正说开的心事。" }
      }
    },
    {
      "id": "shen.frostbond.04.morning-porridge",
      "title": "晨粥微温",
      "subtitle": "她照料人的方式仍像许多年前",
      "chapter": "霜华心契 · 肆",
      "type": "心事",
      "trigger": "time_change",
      "priority": 144,
      "once": true,
      "journal": true,
      "cardStyle": "special",
      "defaultPortrait": "/assets/characters/shen-qingshuang.webp",
      "sceneId": "lingxiao",
      "characterId": "shen",
      "conditions": [
        { "type": "period", "value": "清晨" },
        { "type": "event_completed", "eventId": "shen.frostbond.03.plum-scent" }
      ],
      "clue": "完成「梅香来处」后，在凌霄殿迎来清晨",
      "start": "a",
      "nodes": {
        "a": { "id": "a", "type": "line", "speaker": "narrator", "text": "晨光穿过窗纸时，你发现沈清霜伏在榻边睡着了，手中还握着替你梳理经脉的玉简。", "next": "b", "portrait": "/assets/characters/shen-qingshuang.webp", "stageEffect": "soft_glow" },
        "b": { "id": "b", "type": "line", "speaker": "shen", "text": "醒了？昨夜你练功脱力，是我把你带回来的。", "mood": "倦意未散", "next": "c", "portrait": "/assets/characters/shen-qingshuang.webp" },
        "c": { "id": "c", "type": "line", "speaker": "player", "text": "师尊守了一夜？", "next": "d", "portrait": "/assets/characters/shen-qingshuang.webp" },
        "d": { "id": "d", "type": "line", "speaker": "shen", "text": "从前你发热时，比这难照料得多。你非要攥着我的袖子才肯睡。", "mood": "怀念", "next": "e", "portrait": "/assets/characters/shen-qingshuang.webp", "stageEffect": "heartbeat" },
        "e": { "id": "e", "type": "line", "speaker": "shen", "text": "现在长大了，倒学会把所有难受都藏起来。粥在炉上，不许空腹练剑。", "mood": "温柔训诫", "next": "end", "portrait": "/assets/characters/shen-qingshuang.webp", "effects": [{ "type": "relationship", "characterId": "shen", "amount": 5 }] },
        "end": { "id": "end", "type": "end", "summary": "粥很清淡，却让经脉里的寒意慢慢退去。" }
      }
    },
    {
      "id": "shen.frostbond.05.tea-vow",
      "title": "茶中旧约",
      "subtitle": "一盏雪芽唤醒初遇之夜",
      "chapter": "霜华心契 · 伍",
      "type": "赠礼",
      "trigger": "gift",
      "priority": 142,
      "once": true,
      "journal": true,
      "cardStyle": "special",
      "defaultPortrait": "/assets/characters/shen-qingshuang.webp",
      "sceneId": "lingxiao",
      "characterId": "shen",
      "conditions": [
        { "type": "character", "value": "shen" },
        { "type": "gift", "value": "snowTea" },
        { "type": "event_completed", "eventId": "shen.frostbond.04.morning-porridge" }
      ],
      "clue": "完成「晨粥微温」后赠予沈清霜雪芽灵茶",
      "start": "a",
      "nodes": {
        "a": { "id": "a", "type": "line", "speaker": "shen", "text": "又是雪芽。你可知，我第一次饮这种茶，是在遇见你的那一夜？", "mood": "怀念", "next": "b", "portrait": "/assets/characters/shen-qingshuang.webp", "stageEffect": "soft_glow" },
        "b": { "id": "b", "type": "line", "speaker": "narrator", "text": "她取出一枚磨损的旧铜扣。那是你幼时外袍上遗失的那一枚。", "next": "c", "portrait": "/assets/characters/shen-qingshuang.webp" },
        "c": { "id": "c", "type": "line", "speaker": "shen", "text": "那时我伤得很重，以为自己会死在雪里。你却端着一碗热水，问我要不要跟你回家。", "mood": "坦白", "next": "d", "portrait": "/assets/characters/shen-qingshuang.webp", "stageEffect": "heartbeat" },
        "d": { "id": "d", "type": "line", "speaker": "player", "text": "后来明明是师尊给了我一个家。", "next": "e", "portrait": "/assets/characters/shen-qingshuang.webp" },
        "e": { "id": "e", "type": "line", "speaker": "shen", "text": "所以我偶尔会怕。怕那天只是借来的好运，终有一日要还回去。", "mood": "脆弱", "next": "f", "portrait": "/assets/characters/shen-qingshuang.webp", "stageEffect": "heartbeat" },
        "f": { "id": "f", "type": "line", "speaker": "player", "text": "相遇不是债。我们都可以一次次选择留下。", "next": "g", "portrait": "/assets/characters/shen-qingshuang.webp" },
        "g": { "id": "g", "type": "line", "speaker": "shen", "text": "好。那今日这一次，我选择信你。", "mood": "释然", "next": "end", "portrait": "/assets/characters/shen-qingshuang.webp", "stageEffect": "soft_glow", "effects": [{ "type": "relationship", "characterId": "shen", "amount": 7 }] },
        "end": { "id": "end", "type": "end", "summary": "旧铜扣被放在两盏茶之间，像一枚迟到了许多年的信物。" }
      }
    },
    {
      "id": "shen.frostbond.06.broken-bridge",
      "title": "断桥同归",
      "subtitle": "山河图上的霜光通向一场旧梦",
      "chapter": "霜华心契 · 陆",
      "type": "主线",
      "trigger": "map_event",
      "priority": 140,
